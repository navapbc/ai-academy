{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "supabase-stack",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["supabase", "start"],
      "port": 54323
    },
    {
      "name": "supabase-functions",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["supabase", "functions", "serve", "--env-file", "supabase/functions/.env"],
      "port": 54321
    }
  ]
}
