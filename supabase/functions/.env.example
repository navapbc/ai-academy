# Copy this file to supabase/functions/.env and fill in your real key, then run:
#   supabase functions serve --env-file supabase/functions/.env
#
# supabase/functions/.env is gitignored; this .example file is committed.
# These values are read by the `chat` Edge Function at runtime in the Deno
# env — they are SERVER-SIDE ONLY and must never be VITE-prefixed or imported
# into client code. The browser only ever talks to the Edge Function.

# Required: your Anthropic API key (https://console.anthropic.com/settings/keys).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model (Claude Haiku 4.5, the cheapest current
# model). A per-request `model` field overrides this too.
# ANTHROPIC_MODEL=claude-haiku-4-5

# Required for the `admin-set-role` function (P5.1a): a comma-separated list of
# @navapbc.com emails treated as admins regardless of profiles.role — the
# bootstrap / break-glass set so the very first admin can exist. Put your own
# email here for local dev, then call admin-set-role on yourself with
# role=admin to set profiles.role. SUPABASE_URL / SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY are auto-injected into Edge Functions by the runtime.
# BOOTSTRAP_ADMIN_EMAILS=you@navapbc.com,teammate@navapbc.com

# Optional (P6.2 usage monitoring): if set to a positive integer, the `chat` and
# `grade` functions log a console.warn when a SINGLE model call's total tokens
# (input + output) exceed this value — a cheap operator signal for outsized
# calls. Monitor-only; it never blocks or degrades a call. Leave unset to disable.
# USAGE_ALERT_TOKENS_PER_WINDOW=50000
