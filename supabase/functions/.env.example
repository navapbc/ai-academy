# Copy this file to supabase/functions/.env and fill in your real key, then run:
#   supabase functions serve --env-file supabase/functions/.env
#
# supabase/functions/.env is gitignored; this .example file is committed.
# These values are read by the `chat` Edge Function at runtime in the Deno
# env — they are SERVER-SIDE ONLY and must never be VITE-prefixed or imported
# into client code. The browser only ever talks to the Edge Function.

# Required: your Anthropic API key (https://console.anthropic.com/settings/keys).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model (Claude Haiku 4.5, the cheapest current
# model). A per-request `model` field overrides this too.
# ANTHROPIC_MODEL=claude-haiku-4-5
