# Copy this file to .env and fill in the values printed by `npx supabase start`.
# .env is gitignored; .env.example is committed.

# --- Local Supabase (client-side, safe to expose) ---------------------------
# `npx supabase start` prints these as "Project URL" and the anon key
# (shown as "Publishable" in recent CLI versions, e.g. sb_publishable_...).
# This key is public by design — Row Level Security protects the data.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-or-publishable-key

# --- Claude / Anthropic (server-side only — DO NOT expose to the browser) ----
# Used later by the P1.2 Edge Function proxy. Intentionally NOT VITE-prefixed
# so Vite never bundles it into client code. Leave commented until P1.2.
# ANTHROPIC_API_KEY=sk-ant-...
