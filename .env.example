# Copy this file to .env and fill in the values printed by `npx supabase start`.
# .env is gitignored; .env.example is committed.

# --- Local Supabase (client-side, safe to expose) ---------------------------
# `npx supabase start` prints these as "Project URL" and the anon key
# (shown as "Publishable" in recent CLI versions, e.g. sb_publishable_...).
# This key is public by design — Row Level Security protects the data.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-or-publishable-key

# --- Google SSO (read by the Supabase CLI, NOT by the browser) --------------
# Credentials for the Google OAuth 2.0 Web client used by "Sign in with Google".
# The Supabase CLI substitutes these into supabase/config.toml ([auth.external.google])
# when you run `supabase start` from the repo root, which auto-loads this .env.
# Create the client in Google Cloud Console (a personal/dev project is fine for
# local; the production client lives in the Nava Google org). Set the authorized
# redirect URI to http://127.0.0.1:54321/auth/v1/callback.
# NOTE: GOOGLE_SECRET is a server-side secret — never VITE-prefix it. Neither var
# is exposed to the browser; sign-in still only works for @navapbc.com accounts.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_SECRET=your-google-oauth-client-secret

# --- Claude / Anthropic (server-side only — DO NOT expose to the browser) ----
# The ANTHROPIC_API_KEY does NOT live in this client env file. It is read by the
# `chat` Edge Function at runtime and belongs in supabase/functions/.env (copy
# from supabase/functions/.env.example). Never VITE-prefix it or import it into
# client code — the browser only ever talks to the Edge Function.
